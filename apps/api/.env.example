# Copiar a apps/api/.env y completar. Nunca commitear el .env.
# Las claves del proyecto compartido de Supabase las pasa quien lo administra.
NODE_ENV=development
PORT=3000

# Supabase (proyecto compartido de desarrollo): Project Settings → API Keys.
# La clave secreta (sb_secret_... o la legacy service_role) SOLO va en el backend.
SUPABASE_URL=https://sygfnmoevkydxjwjhcen.supabase.co
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# URL pública del front (redirecciones de auth y links en mails)
FRONTEND_URL=http://localhost:5173

# Si hay un proxy inverso, indicar solo sus IPs o subredes de confianza.
# Sin esta variable, Express toma la IP de la conexión directa e ignora X-Forwarded-For.
# Configurarla antes de que se registren usuarios: la primera región detectada se guarda en su perfil.
# Usar IPs o CIDR separados por comas; no usar true, 1 ni una subred que incluya todas las IPs.
# TRUST_PROXY=10.0.0.0/8

# Región predeterminada, identificada como tal cuando falla la detección por IP
DEFAULT_REGION=AR

# Habilitar solo en una instancia dedicada del despliegue. En local se ejecuta con npm run job.
NODE_CRON_RUN=false

# Integraciones externas
TMDB_API_KEY=
# Necesaria para el job diario de sincronización de disponibilidad.
STREAMING_AVAILABILITY_API_KEY=
# Avisos de disponibilidad por mail (job sendNotifications). Con el remitente de prueba
# onboarding@resend.dev, Resend solo entrega a la dirección de la cuenta de Resend.
RESEND_API_KEY=
RESEND_FROM="Streamly <avisos@tu-dominio.com>"

# Mails de la cuenta (recuperar contraseña, cambiar mail)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM="Streamly <tu.mail@gmail.com>"
